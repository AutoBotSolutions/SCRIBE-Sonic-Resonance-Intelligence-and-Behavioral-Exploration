{
  "audio": {
    "sample_rate": 44100,
    "channels": 1,
    "chunk_size": 1024,
    "format": "float32",
    "device_index": null
  },
  "processing": {
    "window_size": 2048,
    "hop_length": 512,
    "n_fft": 2048,
    "n_mels": 128,
    "fmin": 20.0,
    "fmax": 20000.0
  },
  "ai": {
    "confidence_threshold": 0.7,
    "pattern_matching_threshold": 0.8,
    "anomaly_detection_threshold": 2.0,
    "learning_rate": 0.01,
    "model_update_frequency": 100
  },
  "database": {
    "path": "scribe_learning.db",
    "backup_enabled": true,
    "backup_interval": 3600
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "scribe.log"
  }
}